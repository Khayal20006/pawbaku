# PawBaku run ayarları — bu faylı kopyalayıb .env et:  cp .env.example .env
# Gizli dəyərlər heç vaxt GitHub-a göndərilmir.
#
# Hər dəyəri öz real parol/secret-iniz ilə əvəz edin. <...> mötərizələr
# sadəcə yer tutandır və açıq-aşkar gizli dəyər kimi görünmür.

# PostgreSQL (həm db container, həm backend)
DB_PASSWORD=<postgres parolu>

# HS256 açarı — ƏN AZI 32 bayt (məsələn: openssl rand -base64 48)
JWT_SECRET=<32 baytdan uzun təsadüfi açar>

# İlk admin parolu (ən azı 8 simvol)
BOOTSTRAP_ADMIN_PASSWORD=<admin parolu>

# Frontend portu (nginx) və permission
CORS_ORIGINS=http://localhost:8888
FRONTEND_PORT=8888
BACKEND_PORT=8081
DB_PORT=5433

# ── Email OTP (doğrulama kodu) ──────────────────────────────────────────
# MAIL_ENABLED=false: "demo rejimi" — məktub göndərilmir, kod API cavabında
# previewCode kimi göstərilir ki, registrasiya axınını lokal sınamaq olsun.
# MAIL_ENABLED=true: real SMTP ilə məktub gedir; kod heç vaxt API-dən qaytarılmır.
#MAIL_ENABLED=false
#MAIL_FROM=noreply@pawbaku.az
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=<smtp istifadəçisi>
#SMTP_PASSWORD=<smtp parolu>