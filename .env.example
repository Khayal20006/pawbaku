# PawBaku run ayarları — bu faylı kopyalayıb .env et:  cp .env.example .env
# Gizli dəyərlər heç vaxt GitHub-a göndərilmir.

# PostgreSQL (həm db container, həm backend)
DB_PASSWORD=mysecretpassword

# HS256 açarı — ƏN AZI 32 bayt (məsələn: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-32-plus-byte-secret-string!!
JWT_ISSUER=https://api.pawbaku.az

# İlk admin parolu (ən azı 8 simvol)
BOOTSTRAP_ADMIN_PASSWORD=Admin123!

# Frontend portu (nginx) və permission
CORS_ORIGINS=http://localhost:8888
FRONTEND_PORT=8888
BACKEND_PORT=8081
DB_PORT=5433